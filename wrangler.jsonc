{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "segundo-cerebro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "segundo-cerebro-db",
      "database_id": "5d9116b7-250f-4d05-8ba5-c1d5bc32295c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "segundo-cerebro-uploads"
    }
  ]
}
