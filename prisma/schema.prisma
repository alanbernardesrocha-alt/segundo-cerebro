generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Space {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String   @default("#6b6558")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]
}

model Item {
  id        String   @id @default(cuid())
  type      String   @default("NOTE") // NOTE | FILE | LINK
  title     String
  content   String? // markdown body for notes, description for references
  url       String? // external link target
  fileName  String? // original uploaded file name
  filePath  String? // path under /uploads
  fileSize  Int?
  fileMime  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  connectionsFrom Connection[] @relation("ConnectionSource")
  connectionsTo   Connection[] @relation("ConnectionTarget")

  @@index([spaceId])
}

model Connection {
  id        String   @id @default(cuid())
  label     String?
  createdAt DateTime @default(now())

  sourceId String
  source   Item   @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String
  target   Item   @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}
